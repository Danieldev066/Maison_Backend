# Development only. Generate a unique secret before any public deployment.
SECRET_KEY=dev-only-change-this-very-long-random-secret-1234567890
DATABASE_URL=sqlite:///./maison.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Docker Compose PostgreSQL settings (development only)
POSTGRES_USER=maison
POSTGRES_PASSWORD=maison_dev_password_change_me
POSTGRES_DB=maison
